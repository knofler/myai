# myAI Gateway — Environment Configuration
# Local Docker (default)
MONGODB_URI_LOCAL=mongodb://admin:<password>@mongo:27017/myai?authSource=admin

# Atlas (production)
MONGODB_URI_ATLAS=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myai?retryWrites=true&w=majority

# Active connection — switch between local and atlas
MONGODB_URI=mongodb://admin:<password>@mongo:27017/myai?authSource=admin
MONGODB_NAME=myai

# agentFlow integration — backs `myai new-app "<idea>"` (idea→app pipeline)
# AGENTFLOW_URL=http://host.docker.internal:3000
# AGENTFLOW_TOKEN=<agentflow-bearer-jwt>

# ── LLM providers (all optional — presence of a key enables its lane) ──
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# Kimi lane, direct Moonshot (paid). Base URL/model overridable.
# MOONSHOT_API_KEY=sk-...
# MOONSHOT_MODEL=kimi-k2.6
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Kimi lane via OpenRouter — free K2 without a paid Moonshot key. Activates
# only when set; direct Moonshot wins if both keys are present.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=moonshotai/kimi-k2:free
# GEMINI_API_KEY=...

# ── Envelope encryption at rest (ADR-010 §3.7 — connector secrets & OAuth
# tokens). Without this, a per-process ephemeral key is used and every stored
# secret becomes unreadable on restart — set a real key before storing any
# tenant's live connector credentials. Generate with:
#   openssl rand -base64 32
# MASTER_KMS_KEY=<32 random bytes, base64>
# MASTER_KMS_KEY_VERSION=v1
# Retired key(s), kept only until `myai_rotate_keys.sh master-key` has
# re-wrapped every tenant DEK that used them: {"v1":"<old base64 key>"}
# MASTER_KMS_PREVIOUS_KEYS=

# ── Referral program (GROWTH — core/referrals.ts) ──
# Off by default. When enabled, a successful signup through a tenant's
# tracked `/welcome?ref=<code>` link credits both the referrer and the new
# tenant's creditBalance (core/gift-codes.ts' grant rail).
# REFERRAL_PROGRAM_ENABLED=true
# REFERRAL_CREDITS_REFERRER=60
# REFERRAL_CREDITS_REFEREE=30

# ── Transactional email (shared/mailer.ts + notifications/email-service.ts) ──
# Provider selection: EMAIL_PROVIDER pins one ('resend' | 'smtp' | 'console');
# unset → auto-detect (resend key → smtp host → console log fallback).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# Delivery-events webhook (/api/email/events → bounce/complaint/delivered log
# + auto-suppression). Endpoint is 404 unless this secret is set; the provider
# webhook must send it in the x-email-events-secret header.
# EMAIL_EVENTS_SECRET=<openssl rand -hex 24>

# ── Marketplace publish (marketplace/publish.ts) ──
# Doc links in a published package may point at github.com; list any extra
# documentation domains you trust here (comma-separated, subdomains included).
# MARKETPLACE_DOC_DOMAINS=docs.example.com,example.dev
