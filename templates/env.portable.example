# myAI — portable environment template
#
# Dropped into a target repo by `myai init <path>` (lands at AI/.env.example).
# `myai init` also creates AI/.env from this file on first run (never clobbered on
# re-init). Copy → fill the values you need → `myai up`. Loopback-only, single
# operator: the defaults work out of the box; everything here is optional.
#
# Lines are intentionally comment-free on the value side so this file can be
# copied straight to .env and the compose ${VAR:-default} fallbacks resolve.

# ── Framework install location ────────────────────────────────────────────────
# Where the myAI framework (this repo's runtime/ + dashboard/) lives. The portable
# compose builds the gateway/dashboard images from here. Default assumes the
# sibling layout (../ai_management); set an absolute path if yours differs.
# MYAI_HOME=                  # blank → myai auto-detects the framework install (the package)

# Compose project + container name prefix (keeps stacks from colliding on one host).
# MYAI_PROJECT_NAME=myai      # uncomment + change to run a 2nd stack alongside another

# ── Database ──────────────────────────────────────────────────────────────────
# Leave MONGODB_URI blank to use the bundled mongo container. Set it to point at
# Atlas or an external Mongo (e.g. mongodb+srv://user:pass@cluster/db).
MONGODB_URI=
MONGODB_NAME=myai
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password

# ── Ports (host side) ─────────────────────────────────────────────────────────
# MYAI_MCP_PORT=3100
# MYAI_GATEWAY_HTTP_PORT=3200
# MYAI_GATEWAY_WS_PORT=3201
# MYAI_DASHBOARD_PORT=3210
# MYAI_MONGO_PORT=27200

# ── Secrets ───────────────────────────────────────────────────────────────────
# Required only if you want the gateway's LLM features. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Stable signing secret for dashboard sessions. Change for any non-local deploy.
JWT_SECRET=myai-dev-jwt-secret-change-me
GATEWAY_LOCAL_TOKEN=myai-local-bridge-dev

# Anti-lockout bootstrap admin. Set BOTH to seed an owner login on every boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Edition drives the /welcome flow. independent (default) → self-hosted, single
# operator, local quickstart (no signup). team → multi-tenant signup landing.
# `myai init` sets this from the guided-setup profile question.
MYAI_EDITION=independent
# false (default) → no login wall, dashboard renders locally. true → internet-exposed.
REQUIRE_LOGIN=false
LOG_LEVEL=info

# ── Repos ─────────────────────────────────────────────────────────────────────
# Optional: directory of git repos to register. `myai init` records your answer
# here so you can run `myai scan "$MYAI_SCAN_DIR" --register` after `myai up`.
MYAI_SCAN_DIR=

# ── Memory limits — bump on a beefier machine ─────────────────────────────────
GATEWAY_MEM_LIMIT=1g
GATEWAY_MEM_RESERVATION=256m
DASHBOARD_MEM_LIMIT=512m
DASHBOARD_MEM_RESERVATION=128m
MONGO_MEM_LIMIT=512m
MONGO_MEM_RESERVATION=128m
