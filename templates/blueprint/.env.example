# ── Required ──────────────────────────────────────────────────────────
# MongoDB connection string (local Docker default below; Atlas in prod)
MONGODB_URI=mongodb://admin:password@localhost:27017/__PROJECT_NAME__?authSource=admin
# Anthropic API key for AI calls (sk-ant-...)
ANTHROPIC_API_KEY=

# ── Operator login (control-plane gate — see middleware.ts) ────────────
# Unset by default = FAIL CLOSED: every route not in middleware.ts's
# PUBLIC_PATHS is refused for everyone, operator included, until all three
# vars below are set. Configuring them is a deliberate act, never a default.
# Generate a hash:
#   python3 -c "import hashlib,os,base64,getpass;p=getpass.getpass();s=os.urandom(16);i=210000;print(f'pbkdf2\${i}\${base64.b64encode(s).decode()}\${base64.b64encode(hashlib.pbkdf2_hmac(\"sha256\",p.encode(),s,i)).decode()}')"
# MYAI_ADMIN_USER=
# MYAI_ADMIN_PASSWORD_HASH=
# MYAI_ADMIN_SESSION_SECRET=

# ── Error monitoring (optional — Sentry is a no-op when unset) ─────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Optional / Phase 2 ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
