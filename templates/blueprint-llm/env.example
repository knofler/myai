# Copy to .env — nothing here is secret, and nothing is required to start.
#
# PROJECT_NAME prefixes every container name. Set it to your folder name to
# satisfy the framework's Docker naming rule.
PROJECT_NAME=llmscratch

# Host ports
SERVE_PORT=8000
UI_PORT=8080

# Training knobs. These defaults train in minutes on a laptop CPU — small on
# purpose. Grow them only once the stage tests pass; a bigger model does not
# teach you more, it just fails more slowly.
BLOCK_SIZE=128
BATCH_SIZE=32
N_LAYER=4
N_HEAD=4
N_EMBD=128
LEARNING_RATE=3e-4
MAX_ITERS=2000
VOCAB_SIZE=512
DEVICE=cpu
SEED=1337
