{
  "name": "ai-management",
  "version": "0.7.2",
  "mcpName": "io.github.knofler/myai",
  "description": "myai — a self-owned, git-versioned AI memory + multi-agent framework. Plug any agent (Claude, Cursor, Gemini, Codex, opencode) into your own portable brain so it boots already knowing your projects, decisions, and context. Local-first (Docker), MCP-native, with an autonomous runner, RAG search, a live dashboard, and one-command full-stack app blueprints.",
  "bin": {
    "myai": "bin/myai.cjs",
    "ai-manage": "bin/myai.cjs"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    ".claude/agents/",
    ".claude/skills/",
    "agents/",
    "skills/",
    "hooks/",
    "scripts/",
    "templates/",
    "runtime/src/",
    "runtime/bin/",
    "runtime/package.json",
    "runtime/package-lock.json",
    "runtime/tsconfig.json",
    "runtime/vitest.config.ts",
    "runtime/gateway.config.json",
    "runtime/Dockerfile",
    "runtime/.dockerignore",
    "runtime/docker-compose.yml",
    "runtime/.env.example",
    "runtime/README.md",
    "dashboard/src/",
    "dashboard/public/",
    "dashboard/package.json",
    "dashboard/package-lock.json",
    "dashboard/next.config.ts",
    "dashboard/postcss.config.mjs",
    "dashboard/tsconfig.json",
    "dashboard/Dockerfile",
    "dashboard/.dockerignore",
    "documentation/",
    "config/*.example",
    "config/agent_paths.conf",
    "config/generation-stages.json",
    "config/project-config-template.json",
    "docker-compose.yml",
    "package.json",
    "server.json",
    "README.md",
    "TRY_BRAIN.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "!**/*.test.ts",
    "!**/tests/**",
    "!scripts/tests/**",
    "!scripts/setup_sentry.sh",
    "!scripts/rollout_branching.sh",
    "!scripts/reconcile_review_tasks.sh",
    "!scripts/triage_blocked_tasks.sh",
    "!scripts/audit-state.sh",
    "!scripts/build_clone_ready_branch.sh",
    "!scripts/fleet_resume.sh",
    "!scripts/remote_fleet.sh",
    "!scripts/publish_public_mirror.sh",
    "!scripts/publish_release.sh",
    "!scripts/cli_task_runner.sh",
    "!scripts/machine_selfheal.sh",
    "!scripts/update_all.sh",
    "!scripts/rollout_ci_thrift.sh",
    "!skills/fleet/**",
    "!.claude/skills/fleet/**",
    "!documentation/POWERHOUSE_KEYWORDS.md",
    "!documentation/MULTI_ORG_WORKFLOW.md"
  ],
  "scripts": {
    "smoke": "npm pack --dry-run",
    "publish-guard": "bash scripts/publish_guard.sh",
    "prepublishOnly": "bash scripts/publish_guard.sh",
    "release:plan": "python3 scripts/release_version.py next",
    "release:notes": "python3 scripts/release_version.py notes",
    "release:apply": "python3 scripts/release_version.py apply"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "keywords": [
    "ai",
    "cli",
    "claude",
    "claude-code",
    "framework",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "agent-memory",
    "brain",
    "portable-memory",
    "memory",
    "mcp",
    "model-context-protocol",
    "rag",
    "vector-search",
    "autonomous-agents",
    "task-runner",
    "dashboard",
    "devops",
    "scaffolding",
    "blueprint",
    "nextjs",
    "docker",
    "anthropic",
    "llm",
    "developer-tools"
  ],
  "homepage": "https://github.com/knofler/myai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knofler/myai.git"
  },
  "bugs": {
    "url": "https://github.com/knofler/myai/issues"
  },
  "license": "MIT",
  "author": "knofler"
}